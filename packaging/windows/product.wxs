<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows MSI definition, built with WiX v5 (`wix build`, not the older
  candle.exe/light.exe from WiX v3). Built by
  .github/workflows/release.yml on every `v*.*.*` tag; see that workflow
  for the exact `-d Version`, `-d SourceDir`, and `-d RepoRoot` values
  passed in.

  Deliberately minimal for a first release: installs the two binaries,
  the default config, LICENSE/README, and a Start Menu shortcut to run the
  service; relies on MSI's built-in Programs and Features entry for
  uninstall (nothing custom needed). Does NOT add the install folder to
  PATH yet; that needs the WiX Util extension (util:Environment), left out
  to keep this first cut to core WiX only. See docs/architecture.md
  roadmap for adding it later.

  Note for future edits: XML comments cannot contain a double hyphen
  anywhere in their body, so avoid this project's usual em-dash-via-double-
  hyphen prose style inside this file's comments specifically.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="logitech-sim-led"
           Manufacturer="Glenn Schuurman"
           Version="$(var.Version)"
           UpgradeCode="90179532-f82e-429b-ade2-1f51d1b56419"
           Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.RepoRoot)\crates\sld-service\assets\icons\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="logitech-sim-led">
        <Directory Id="ConfigFolder" Name="config" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="logitech-sim-led" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="logitech-sim-led" Level="1">
      <ComponentRef Id="ServiceExeComponent" />
      <ComponentRef Id="CliExeComponent" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="ReadmeComponent" />
      <ComponentRef Id="ConfigComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <Component Id="ServiceExeComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SldServiceExe" Source="$(var.SourceDir)\sld-service.exe" KeyPath="yes" />
    </Component>

    <Component Id="CliExeComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SldCliExe" Source="$(var.SourceDir)\sld-cli.exe" KeyPath="yes" />
    </Component>

    <Component Id="LicenseComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="LicenseTxt" Source="$(var.RepoRoot)\LICENSE" KeyPath="yes" />
    </Component>

    <Component Id="ReadmeComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="ReadmeMd" Source="$(var.RepoRoot)\README.md" KeyPath="yes" />
    </Component>

    <Component Id="ConfigComponent" Directory="ConfigFolder" Guid="*">
      <File Id="DefaultToml" Source="$(var.RepoRoot)\config\default.toml" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="ServiceShortcut"
                Name="logitech-sim-led"
                Description="Run the logitech-sim-led telemetry/LED service"
                Target="[INSTALLFOLDER]sld-service.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <!--
        Per-machine package (ProgramFiles64Folder above), so this keypath
        must be HKLM, not HKCU: a component whose only keypath is an HKCU
        registry value is unreliable in a per-machine install (MSI may
        advertise it instead of writing it immediately, depending on who's
        installing and how). Confirmed the hard way: this shortcut
        silently never appeared with HKCU here.
      -->
      <RegistryValue Root="HKLM" Key="Software\logitech-sim-led" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      TODO(installer wizard): `UIRef Id="WixUI_InstallDir"` (from
      WixToolset.UI.wixext 5.0.2, loaded with `-ext WixToolset.UI.wixext`)
      resolves but fails with WIX0094 "inaccessible due to its protection
      level", which looks like a packaging quirk specific to this
      extension version rather than a syntax error (UIRef/Property/
      WixVariable structure was confirmed correct against the extension
      DLL's own WIXUI_INSTALLDIR property name). Revisit once the
      packaging rewrite for the GUI app (see main.rs/gui.rs) replaces
      this file anyway: new exe, new icon, new shortcuts, worth
      re-deriving the UI wiring fresh rather than patching this cut
      further. Until then this MSI installs non-interactively only
      (msiexec /qn or /qb): no Welcome/License/browse-for-folder/Finish
      wizard, no /qf default UI.
      license.rtf in this directory is ready for whenever this is fixed.
    -->

  </Package>
</Wix>
